# 必填：阿里云百炼 API Key 和业务空间 ID
DASHSCOPE_API_KEY=replace-with-your-api-key
BAILIAN_WORKSPACE_ID=replace-with-your-workspace-id

# Realtime 模型配置
BAILIAN_MODEL=qwen3.5-omni-plus-realtime
QWEN_REALTIME_REGION=cn-beijing
# 可选：留空时按教练自动选择音色；填写后所有教练强制使用同一音色
QWEN_REALTIME_VOICE=
QWEN_VOICE_CLARA=Serena
QWEN_VOICE_JAMES=Raymond
QWEN_VOICE_LEO=Ryan
QWEN_VOICE_DAVID=Andre
QWEN_VOICE_EMILY=Mione
QWEN_VOICE_ARTHUR=Harvey
QWEN_VAD_TYPE=semantic_vad
QWEN_TRANSCRIPTION_MODEL=qwen3-asr-flash-realtime

# 场景生成和旁路语义抽取模型
SCENARIO_GENERATOR_MODEL=qwen-plus
SCENARIO_EXTRACTOR_MODEL=qwen3.5-flash
QWEN_COMPATIBLE_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions

# 可选：服务端口和无 profile 请求时的默认提示词组合
SERVER_PORT=8081
PROMPT_DEFAULT_COACH=clara
PROMPT_DEFAULT_DIFFICULTY=basic
PROMPT_DEFAULT_SPEED=1.0
PROMPT_DEFAULT_CORRECTION=moderate

# 可选：只有使用自建兼容网关时才填写；填写后不再用 workspace/region 拼接地址
# QWEN_REALTIME_ENDPOINT=https://your-gateway.example/api/v1/webrtc/realtime?model=your-model
