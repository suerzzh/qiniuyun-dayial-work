DASHSCOPE_API_KEY=replace-with-your-api-key
BAILIAN_WORKSPACE_ID=replace-with-your-workspace-id
BAILIAN_MODEL=qwen3.5-omni-plus-realtime
QWEN_SCORING_MODEL=qwen-plus
QWEN_IELTS_JUDGE_MODEL=qwen-plus
# IELTS prompts are versioned classpath resources by default. They may also be
# replaced with file:/absolute/path/to/prompt.txt without changing Java code.
IELTS_PROMPT_VERSION=ielts-2026-07-21.1
IELTS_EXAMINER_PROMPT_RESOURCE=classpath:prompts/ielts/examiner-system.txt
IELTS_LANGUAGE_PROMPT_RESOURCE=classpath:prompts/ielts/language-evidence.txt
IELTS_JUDGE_PROMPT_RESOURCE=classpath:prompts/ielts/judge.txt
XFYUN_APPID=replace-with-your-xfyun-appid
XFYUN_APIKEY=replace-with-your-xfyun-api-key
XFYUN_APISECRET=replace-with-your-xfyun-api-secret
# Current Demo implementation uses read_sentence evidence and marks it LOW confidence.
# Change only after the account and API implementation truly support the configured mode.
XFYUN_IELTS_MODE=read_sentence
VAD_SILENCE_DURATION_MS=800
IDLE_TIMEOUT_MS=0
LATENCY_REPORT_FILE=data/latency_report.md
BASE_SYSTEM_PROMPT=
LEARNER_PROFILE_FILE=data/conversations.json
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
